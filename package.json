{
  "name": "bootstrap-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Formatting and linting toolchain for the bootstrap repository itself (not shipped in the template payload).",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml}\"",
    "spell": "cspell lint --no-progress --dot \"**/*\"",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "cspell": "10.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  }
}
