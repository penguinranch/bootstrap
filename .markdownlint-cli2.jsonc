{
  "config": {
    // Prettier owns line width, and tables and link-heavy prose exceed 80 by design
    "MD013": false,
    // a pull-quote followed by a GitHub alert renders as two blockquotes,
    // but reads as one with a blank line in it to this rule
    "MD028": false,
    "MD029": { "style": "ordered" },
    // PR and issue templates render inside a form where an H1 would be wrong
    "MD041": false
  },
  // .agents/ holds agent workflow definitions, not prose. Their numbered steps
  // interleave column-0 code fences and '// turbo' directives, which this
  // linter reads as a broken list and the agent runner reads as significant.
  "globs": ["**/*.md", "!node_modules", "!.agents"]
}
