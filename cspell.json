{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "package-lock.json",
    ".devcontainer/devcontainer-lock.json"
  ],
  "ignoreRegExpList": ["AAAA[A-Za-z0-9+/=]+", "gh[a-z]_[A-Za-z0-9]+"],
  "words": [
    "anson",
    "aquasecurity",
    "automations",
    "bierner",
    "blockquotes",
    "dockerfiles",
    "dotenv",
    "dpkg",
    "esac",
    "esbenp",
    "eslintcache",
    "gomod",
    "gpgsign",
    "gsub",
    "makefiles",
    "mechatroner",
    "mktemp",
    "moby",
    "noninteractive",
    "nullary",
    "nvmrc",
    "passthroughs",
    "penguinranch",
    "pipefail",
    "pycache",
    "pytest",
    "pythonpath",
    "repointed",
    "sarif",
    "sdist",
    "shellcheck",
    "signingkey",
    "sigpipe",
    "subshell",
    "timonwong",
    "tmpl",
    "toplevel",
    "trixie",
    "unconfigured",
    "venv"
  ]
}
