{
  "name": "{{PROJECT_NAME}}",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [3000, 9222],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gemini-cli-config-${devcontainerId},target=/home/vscode/.gemini,type=volume"
  ],
  "postCreateCommand": "bash ./scripts/create-container.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid",
        "mechatroner.rainbow-csv",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries",
        "streetsidesoftware.code-spell-checker",
        "anthropic.claude-code",
        "google.gemini-cli-vscode-ide-companion",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "workbench.startupEditor": "none",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.suggestSelection": "first",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "markdown.preview.breaks": true,
        "markdown.preview.doubleClickToSwitchToEditor": true
      }
    }
  },
  "containerEnv": {
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "postStartCommand": "/bin/bash ./scripts/start-container.sh"
}
