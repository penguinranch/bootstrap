# Environment
.env
.env.*
!.env.example

# Node
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Python
# The generic directory names (env, lib, lib64, var) are deliberately absent.
# Anchoring them to the repo root does not make them safe: an Elixir project's
# source tree IS /lib, and a Rails or Phoenix project's scripts ARE /bin, so the
# payload would silently untrack real source from the first commit. A Python or
# Go project adds the ones it needs back during the kickoff.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/

# Go
# /bin and /obj are absent for the reason above.
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# Mac
.DS_Store

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp

# Generated by 'make ai-context' — a bundle for pasting into an AI chat,
# never meant to be committed (and unformatted, so it would break lint)
context-for-ai.md

# Drafted PR bodies. Lynn writes one here and copies it to GitHub by hand, so it
# is never committed, and its prose would fail the spell check.
pr-body.md

# Bootstrap sentinel
.devcontainer/.bootstrapped

# Testing
.tmp-test/
