    "esac",
    "esbenp",
    "gomod",
    "gpgsign",
    "gsub",
    "mechatroner",
    "moby",
    "noninteractive",
    "passthroughs",
    "penguinranch",
    "pythonpath",
    "sarif",
    "signingkey",
    "trixie",
    "unconfigured"
  ]
